# Variables del servidor local de desarrollo (npm run dev).
#
# Copia este archivo como .env y rellena el token. El archivo .env NO se sube a git
# (está en .gitignore); este .env.example sí, y por eso no lleva ningún valor real.

# Token con el que entras al Panel. Obligatorio, de al menos 32 caracteres.
# Para generar uno:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
#
# Usa aquí un token SOLO de desarrollo. No pongas nunca el token real de producción.
LOCAL_OWNER_TOKEN=

# Opcionales (descomenta para cambiarlos):
# PORT=8787
# LOCAL_WS_URL=ws://localhost:5173/ws
